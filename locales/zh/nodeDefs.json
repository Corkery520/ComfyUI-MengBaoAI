{
  "MengBaoImageReverse": {
    "display_name": "萌宝AI·图片反推",
    "description": "识别构图与可替换元素，优先使用 GEM 3.7 flash，连接失败切换 GEM 3.8 flash。",
    "inputs": { "image": { "name": "原图" }, "request_id": { "name": "识别请求" } },
    "outputs": { "0": { "name": "分析数据" }, "1": { "name": "反推提示词" } }
  },
  "MengBaoImageReplicaSettings": {
    "display_name": "萌宝AI·图片复刻设置",
    "description": "校正元素位置、修改文字和替换素材，确认后连接图像生成。",
    "inputs": { "analysis": { "name": "分析数据" }, "draft_json": { "name": "草稿" }, "draft_id": { "name": "草稿 ID" } },
    "outputs": { "0": { "name": "提示词" }, "1": { "name": "复刻设置" } }
  },
  "MengBaoReplicaAudit": {
